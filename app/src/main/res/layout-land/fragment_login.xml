<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25" />

    <TextView
        android:id="@+id/login_header"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:fontFamily="@font/lufga_bold"
        android:text="@string/login_header"
        android:textColor="@color/login_big_text"
        android:textSize="64sp"
        app:layout_constraintBottom_toTopOf="@id/guideline_first"
        app:layout_constraintEnd_toEndOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="@id/rounded_rectangle_view" />


    <View
        android:id="@+id/rounded_rectangle_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/reverse_rounded_rectangle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintWidth_percent="0.35" />

    <ImageView
        android:id="@+id/login_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/young_man_descrition"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rounded_rectangle_view"
        app:srcCompat="@drawable/young_man" />


    <FrameLayout
        android:id="@+id/email_main_frame"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/edit_text_background"
        app:layout_constraintBottom_toBottomOf="@id/guideline_first"
        app:layout_constraintEnd_toStartOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/editTextTextEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="email"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/mail"
            android:drawablePadding="12dp"
            android:fontFamily="@font/rubik_regular"
            android:hint="Enter your email"
            android:imeOptions="actionNext"
            android:importantForAutofill="yes"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingStart="31dp"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_gmail_text"
            android:textSize="16sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/email_hint_frame"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginStart="38dp"
        android:background="@color/background"
        app:layout_constraintBottom_toTopOf="@id/email_main_frame"
        app:layout_constraintStart_toStartOf="@id/email_main_frame"
        app:layout_constraintTop_toTopOf="@id/email_main_frame">

        <TextView
            android:id="@+id/email_hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rubik_medium"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="Email"
            android:textColor="@color/hint_gmail_upper_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/password_main_frame"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/edit_text_background"
        app:layout_constraintEnd_toStartOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/email_main_frame">

        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="password"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/lock_password"
            android:drawableEnd="@drawable/view_off_slash"
            android:drawablePadding="12dp"
            android:fontFamily="@font/rubik_regular"
            android:hint="Enter your password"
            android:imeOptions="actionDone"
            android:importantForAutofill="yes"
            android:inputType="textVisiblePassword"
            android:maxLines="1"
            android:paddingStart="31dp"
            android:paddingEnd="31dp"
            android:textColor="@color/black"
            android:textColorHint="@color/hint_gmail_text"
            android:textSize="16sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/password_hint_frame"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginStart="38dp"
        android:background="@color/background"
        app:layout_constraintBottom_toTopOf="@id/password_main_frame"
        app:layout_constraintStart_toStartOf="@id/password_main_frame"
        app:layout_constraintTop_toTopOf="@id/password_main_frame">

        <TextView
            android:id="@+id/password_hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rubik_medium"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="Password"
            android:textColor="@color/hint_gmail_upper_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>


    <TextView
        android:id="@+id/forgot_password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"
        android:fontFamily="@font/rubik_medium"
        android:text="Forgot Password"
        android:textColor="@color/forgot_text"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/password_main_frame"
        app:layout_constraintTop_toBottomOf="@+id/password_main_frame" />

    <Button
        android:id="@+id/login_button"
        style="@style/MyButton"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:fontFamily="@font/rubik_semi_bold"
        android:text="Login"
        android:textColor="@color/login_button_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/forgot_password_text" />

    <TextView
        android:id="@+id/orText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/rubik_regular"
        android:text="- or -"
        android:textColor="@color/or_text"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_button" />

    <LinearLayout
        android:id="@+id/icons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orText">


        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/google_icon" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/facebook_icon" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/apple_icon" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rounded_rectangle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icons_layout"
        app:layout_constraintTop_toTopOf="@id/icons_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rubik_regular"
            android:text="Don't have an account?"
            android:textColor="@color/or_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/sign_up_text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/rubik_semi_bold"
            android:text="Sign up"
            android:textColor="@color/sign_up_text" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>